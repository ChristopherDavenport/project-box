bin/
# Rooted: hack/continuity and hack/deployloop are source. Unrooted patterns
# would ignore the sources along with the binaries built beside them.
/continuity
/deployloop
*.db
*.db-wal
*.db-shm
web/node_modules/
hack/room-smoke/node_modules/
hack/room-smoke/package*.json

# Dogfood: the factory's own state (store, mirrors, workspaces, logs).
# The HARNESS that produces it is tracked, in hack/dogfood.
.factory/
__pycache__/
